# Copier en `deploy/.env`. Lu par docker compose lui-meme (domaine, base).
# Aucun secret reel ne doit apparaitre dans ce fichier d'exemple.

# Le nom de domaine qui pointe sur le serveur. Caddy y demande le certificat.
# Pour tester avant propagation du DNS : <ip-du-vps>.nip.io
DOMAINE=exemple.fr

# Let's Encrypt refuse une adresse sans domaine valable : sans elle, aucun
# certificat n'est emis et le site ne repond qu'en HTTP.
EMAIL_ACME=vous@exemple.fr

# Base applicative. Le mot de passe doit correspondre a celui du DATABASE_URL
# de deploy/.env.prod.
POSTGRES_USER=megslab
POSTGRES_PASSWORD=a-remplacer
