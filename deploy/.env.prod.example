# Copier en `deploy/.env.prod`. Reglages du backend de production.
# Aucun secret reel ne doit apparaitre dans ce fichier d'exemple.

# Refuse le demarrage si un secret ci-dessous manque, plutot que de tourner
# avec un secret JWT genere a la volee — qui deconnecte tout le monde a chaque
# redemarrage, en silence.
ENVIRONNEMENT=production

# Base applicative. `postgres` est le nom du service dans le compose ; le mot de
# passe doit correspondre a POSTGRES_PASSWORD de deploy/.env.
DATABASE_URL=postgresql+asyncpg://megslab:a-remplacer@postgres:5432/megslab_prod

# Signature des jetons de session. En generer un dedie au serveur :
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Doit contenir l'adresse publique EXACTE du front, protocole compris. Si elle
# manque, le navigateur bloque les appels et l'interface affiche une erreur
# reseau alors que le serveur repond parfaitement.
CORS_ORIGINS=https://exemple.fr

ANTHROPIC_API_KEY=

# Airbyte, servi par Caddy sur son propre sous-domaine.
#
# Les deux valeurs sont identiques, et c'est voulu : des qu'abctl est installe
# avec --host, son ingress n'accepte plus que les noms declares. Le nom interne
# du conteneur cesse alors de fonctionner, et le backend doit passer par la
# meme URL publique que le navigateur.
AIRBYTE_BASE_URL=https://airbyte.exemple.fr
AIRBYTE_URL_PUBLIQUE=https://airbyte.exemple.fr
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Entrepot, vu depuis AIRBYTE, qui y ecrit depuis le reseau `kind`.
WAREHOUSE_POSTGRES_HOST=megslab-warehouse-postgres
WAREHOUSE_POSTGRES_PORT=5432
WAREHOUSE_POSTGRES_DATABASE=warehouse
WAREHOUSE_POSTGRES_USERNAME=megslab
WAREHOUSE_POSTGRES_PASSWORD=

# Meme entrepot, vu depuis le BACKEND, qui y lit. Deploye a cote sur le reseau
# `kind`, il le nomme directement : le tunnel SSH du poste de developpement ne
# sert qu'en local.
WAREHOUSE_LECTURE_HOST=megslab-warehouse-postgres
WAREHOUSE_LECTURE_PORT=5432

# Schema de l'entrepot contenant le jeu de demonstration (vide = desactive).
DEMO_SCHEMA=demo_olist
