# Copier en .env et renseigner les valeurs reelles. Ne jamais commiter .env.

# API
CORS_ORIGINS=http://localhost:3000

# Base de donnees applicative
DATABASE_URL=sqlite+aiosqlite:///./data/megslab.db

# Signature des jetons de session (genere : python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=

# Fournisseurs LLM (au moins une cle est necessaire pour les fonctionnalites IA)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Airbyte OSS (auto-heberge, voir docs/deploiement)
AIRBYTE_BASE_URL=http://178.32.16.63:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Kaggle (telechargement du jeu de donnees Olist pour la demo, Checkpoint 3)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Entrepot partage (une base Postgres, un schema par organisation).
# Adresse joignable depuis le cluster Airbyte (reseau "kind"), pas forcement
# depuis le backend.
WAREHOUSE_POSTGRES_HOST=
WAREHOUSE_POSTGRES_PORT=5432
WAREHOUSE_POSTGRES_DATABASE=warehouse
WAREHOUSE_POSTGRES_USERNAME=
WAREHOUSE_POSTGRES_PASSWORD=

# Meme entrepot, vu depuis le backend (qui lit) et non depuis Airbyte (qui ecrit).
# En developpement, ouvrir le tunnel : ssh -N -L 55433:<ip entrepot>:5432 <serveur>
WAREHOUSE_LECTURE_HOST=127.0.0.1
WAREHOUSE_LECTURE_PORT=55433
