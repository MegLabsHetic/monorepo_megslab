# Copier en .env et renseigner les valeurs reelles. Ne jamais commiter .env.

# API
CORS_ORIGINS=http://localhost:3000

# Base de donnees applicative
DATABASE_URL=sqlite+aiosqlite:///./data/megslab.db

# Signature des jetons de session (genere : python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=

# Fournisseurs LLM (au moins une cle est necessaire pour les fonctionnalites IA)
ANTHROPIC_API_KEY=

# Chaine de fournisseurs de modele, du prefere au dernier recours.
# Vide : « anthropic:claude-opus-5 », le comportement historique.
# Rabattre suppose le MEME modele chez plusieurs hebergeurs, sinon une bascule
# ferait varier la qualite des reponses sans le dire.
# LLM_CHAINE=ovhcloud:gpt-oss-120b,scaleway:gpt-oss-120b,ionos:gpt-oss-120b
LLM_CHAINE=

# Routage par agent : quel MODELE pour quelle tache. Vide = LLM_CHAINE.
# L'Analyste determine le score du produit ; le Redacteur et le Viz produisent
# une phrase et un choix de graphique. Un agent non declare garde la chaine
# commune — il ne tombe jamais sur un modele au hasard.
# LLM_CHAINE_ANALYSTE=ovhcloud:Qwen3.5-397B-A17B,scaleway:Qwen3.5-397B-A17B
# LLM_CHAINE_REDACTEUR=ovhcloud:gpt-oss-20b
# LLM_CHAINE_VIZ=ovhcloud:gpt-oss-20b
LLM_CHAINE_ANALYSTE=
LLM_CHAINE_REDACTEUR=
LLM_CHAINE_VIZ=

# Ordonnanceur des surveillances. Eteint par defaut : sans lui, le backend se
# comporte exactement comme avant. Avec plusieurs repliques, chacune executerait
# les memes surveillances — ne l'activer que sur une seule instance tant
# qu'aucun verrou partage n'existe.
ORDONNANCEUR_ACTIF=false

OVHCLOUD_API_KEY=
SCALEWAY_API_KEY=
IONOS_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Airbyte OSS (auto-heberge, voir docs/deploiement)
AIRBYTE_BASE_URL=http://178.32.16.63:8000
# URL qu'un navigateur peut atteindre, pour les liens de configuration avancee
AIRBYTE_URL_PUBLIQUE=http://178.32.16.63:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Kaggle (telechargement du jeu de donnees Olist pour la demo, Checkpoint 3)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Entrepot partage (une base Postgres, un schema par organisation).
# Adresse joignable depuis le cluster Airbyte (reseau "kind"), pas forcement
# depuis le backend.
WAREHOUSE_POSTGRES_HOST=
WAREHOUSE_POSTGRES_PORT=5432
WAREHOUSE_POSTGRES_DATABASE=warehouse
WAREHOUSE_POSTGRES_USERNAME=
WAREHOUSE_POSTGRES_PASSWORD=

# Meme entrepot, vu depuis le backend (qui lit) et non depuis Airbyte (qui ecrit).
# En developpement, ouvrir le tunnel : ssh -N -L 55433:<ip entrepot>:5432 <serveur>
WAREHOUSE_LECTURE_HOST=127.0.0.1
WAREHOUSE_LECTURE_PORT=55433

# Schema de l'entrepot contenant le jeu de demonstration a copier en un clic (vide = desactive)
DEMO_SCHEMA=
