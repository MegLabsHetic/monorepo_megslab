# Copier en .env.production sur le serveur et renseigner les valeurs reelles.
# Ce fichier-ci ne contient que des valeurs factices ; .env.production est
# ignore par git.

# Refuse le demarrage si un secret ci-dessous manque.
ENVIRONNEMENT=production

# Le nom de domaine qui pointe sur le serveur. Caddy y demande le certificat.
DOMAINE=megslab.exemple.fr

# L'API et l'interface partagent le domaine : /api est redirige vers le backend.
NEXT_PUBLIC_API_URL=https://megslab.exemple.fr/api
# Meme origine que le front, donc aucune origine tierce a autoriser.
CORS_ORIGINS=https://megslab.exemple.fr

# Base applicative. L'hote « base » est le nom du service dans le compose.
POSTGRES_DB=megslab
POSTGRES_USER=megslab
POSTGRES_PASSWORD=a-remplacer
DATABASE_URL=postgresql+asyncpg://megslab:a-remplacer@base:5432/megslab

# Signature des jetons de session. En generer un dedie au serveur :
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

ANTHROPIC_API_KEY=

# Airbyte. Une fois le backend deploye a cote, cette adresse est INTERNE et le
# port ne doit plus etre ouvert sur l'exterieur.
AIRBYTE_BASE_URL=http://airbyte-abctl-control-plane:8000
AIRBYTE_URL_PUBLIQUE=https://airbyte.exemple.fr
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Entrepot, vu depuis Airbyte (qui ecrit).
WAREHOUSE_POSTGRES_HOST=
WAREHOUSE_POSTGRES_PORT=5432
WAREHOUSE_POSTGRES_DATABASE=warehouse
WAREHOUSE_POSTGRES_USERNAME=
WAREHOUSE_POSTGRES_PASSWORD=

# Meme entrepot, vu depuis le backend (qui lit). Deploye sur le meme serveur,
# c'est une adresse interne : le tunnel SSH du poste de developpement disparait.
WAREHOUSE_LECTURE_HOST=172.20.0.4
WAREHOUSE_LECTURE_PORT=5432

DEMO_SCHEMA=demo_olist
